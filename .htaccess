# ERGO-PLUS – Security & Caching (Apache / klassisches Hosting)

# --- Security-Header ---
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"
</IfModule>

# --- Eine einzige gueltige Adresse: https://ergo-plus.de/ ---
# Alle canonical-Angaben und die Sitemap nennen die Domain ohne www und
# ueber https. Google hat aber http://www.ergo-plus.de/ im Index. Ohne die
# erste Regel bliebe das www nach der HTTPS-Weiterleitung erhalten, und die
# Seite gaebe es weiterhin unter zwei Adressen.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www entfernen und dabei gleich auf https gehen. Muss vor der Regel
  # darunter stehen, sonst braucht ein Aufruf von http://www. zwei
  # Weiterleitungen statt einer.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --- PHP2Shell-Abwehr (CVE-2026-109618 / CVE-2026-109619), Okt. 2026 ---
# Beide Luecken werden ausgeloest, bevor PHP-Code laeuft: ueber multipart-
# Uploads, Speicherdruck beim Request-Aufbau und manipulierte PHPSESSID-Cookies.
# Diese Seite braucht nichts davon: das Kontaktformular sendet urlencoded,
# der Konfigurator JSON, und PHP nutzt hier keine Cookies/Sessions.
# Unabhaengig davon, ob STRATO PHP schon gepatcht hat, kommen diese Muster
# gar nicht erst bei PHP an.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{HTTP:Content-Type} multipart/ [NC]
  RewriteRule ^ - [F,L]
  # Ohne Laengenangabe (chunked) kein Request an PHP.
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{HTTP:Transfer-Encoding} chunked [NC]
  RewriteRule ^ - [R=411,L]
  # Kontaktformular: Text, max. 6 Felder a 5000 Zeichen -> ab 1 MB abweisen.
  # (LimitRequestBody greift bei PHP-FPM aus der .htaccess nicht zuverlaessig.)
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{HTTP:Content-Length} ^[0-9]{7,}$
  RewriteRule ^ - [R=413,L]
</IfModule>
<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    RequestHeader unset Cookie
  </IfModule>
</FilesMatch>
<Files ".user.ini">
  Require all denied
</Files>

# --- Eigene 404-Seite ---
ErrorDocument 404 /404.html

# --- Verzeichnislisting aus ---
Options -Indexes
